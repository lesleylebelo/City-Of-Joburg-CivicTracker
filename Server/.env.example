# Placeholders only. Replace every used value locally; remove unused optional lines.
# This file is documentation, not a ready-to-run environment. Defaults: README.md.
DB_HOST=<supabase-postgres-or-session-pooler-host>
DB_NAME=<database-name>
DB_PORT=<tcp-port>
DB_USER=<dedicated-postgres-role-or-session-pooler-user>
DB_PASSWORD=<set-locally>
DB_SSL_MODE=<require-or-disable-for-loopback-only>
DB_SSL_CA_FILE=<optional-path-to-provider-ca-certificate-or-remove>
DB_POOL_MAX=<positive-integer>
DB_CONNECT_TIMEOUT_MS=<positive-milliseconds>
DB_REQUEST_TIMEOUT_MS=<positive-milliseconds>
PORT=<http-port>
JWT_SECRET=<set-locally>
JWT_EXPIRES_IN=<jwt-duration>
CORS_ALLOWED_ORIGINS=<exact-origins-separated-by-commas-or-empty>
# Optional, real-SQL verification only. Never run during fixture-only testing.
TEST_RESIDENT_IDENTIFIER=<existing-test-account-identifier>
TEST_RESIDENT_PASSWORD=<set-locally>
TEST_ADMIN_IDENTIFIER=<existing-test-account-identifier>
TEST_ADMIN_PASSWORD=<set-locally>

# Explicit opt-in for fresh, non-production test-account setup only.
TEST_DATABASE_SEED_CONFIRM=<empty-test-database>
NODE_ENV=<development-or-production>
IMAGE_STORAGE_PROVIDER=<local-or-supabase>
SUPABASE_URL=<https-project-ref-supabase-co>
SUPABASE_SECRET_KEY=<backend-only-secret-key-set-locally>
SUPABASE_IMAGE_BUCKET=<private-bucket-name>
IMAGE_STORAGE_TIMEOUT_MS=<positive-milliseconds-between-1000-and-60000>
