# Use the hostname and actual enabled TCP port for your development SQL instance.
DB_HOST=localhost
DB_NAME=civictrack_db
DB_PORT=1433

DB_USER=your_username
DB_PASSWORD=your_password

PORT=3001

# Set a long, randomly generated secret locally; do not commit it.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# SQL transport and connection limits (replace placeholders; see Server/README.md).
DB_ENCRYPT=<true-or-false-default-true>
DB_TRUST_SERVER_CERT=<true-or-false-default-false>
DB_POOL_MAX=<positive-integer-default-5>
DB_CONNECT_TIMEOUT_MS=<milliseconds-default-15000>
DB_REQUEST_TIMEOUT_MS=<milliseconds-default-15000>
CORS_ALLOWED_ORIGINS=<comma-separated-exact-frontend-origins-or-empty>
